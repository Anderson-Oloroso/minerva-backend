# -------------------------------
# SERVIDOR / APLICACION
# -------------------------------
PORT=5000
NODE_ENV=development
# Keep the API major version aligned with package.json (e.g. /api/v1 for 1.x.x).
API_PREFIX=/api/v1

# -------------------------------
# BASE DE DATOS (MYSQL)
# -------------------------------
DB_HOST=db
DB_PORT=3306
DB_PUBLISHED_PORT=3307
DB_USER=root
DB_PASSWORD=secretpassword
# When DB_USER=root, DB_PASSWORD and DB_ROOT_PASSWORD must match.
DB_ROOT_PASSWORD=secretpassword
DB_NAME=minerva_lib_db
DB_CONNECTION_LIMIT=10

# -------------------------------
# AUTENTICACION Y SEGURIDAD (JWT)
# -------------------------------
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# -------------------------------
# CONFIGURACION DE CORS
# -------------------------------
# Empty allows requests from any origin; otherwise use comma-separated origins.
CORS_ORIGIN=

# -------------------------------
# SEGURIDAD / RATE LIMITING
# -------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
